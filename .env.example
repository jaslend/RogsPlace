# Copy to .env.local and adjust as needed. .env.local is never committed.
#
# Everything prefixed VITE_ is compiled into the browser bundle and is public.
# Never put an API key, token or any other secret in this file.

# --- Backend -----------------------------------------------------------------

# Base URL of the backend API.
#
# Leave it unset (or empty) to use the local mock data in src/data/, which is
# how the site runs until the Cloudflare Worker exists.
#
# Local Worker (wrangler dev):
# VITE_API_URL=http://localhost:8787
#
# Test Worker:
# VITE_API_URL=https://rogsplace-api-test.example.workers.dev
#
# Production:
# VITE_API_URL=https://rogsplace.example/api

# --- Memorial details --------------------------------------------------------
#
# The real details are supplied at build time rather than committed, so that a
# clone or a fork of this repository only gets the placeholder content in
# src/data/site.json. Anything left unset falls back to that placeholder.
#
# On GitHub these come from repository variables named without the VITE_SITE_
# prefix -- SITE_NAME, SITE_TITLE and so on. See the README.
#
# This is content, not secrets: it is compiled into the bundle and shown on the
# page. It is only kept out of the repository, not out of the published site.

# VITE_SITE_TITLE=In Loving Memory
# VITE_SITE_NAME=
# VITE_SITE_DATE_OF_BIRTH=1938-04-17
# VITE_SITE_DATE_OF_DEATH=2026-02-03
# VITE_SITE_WELCOME_TEXT=
# Path relative to the site root, or an absolute URL:
# VITE_SITE_MAIN_PHOTO=photos/main.jpg
