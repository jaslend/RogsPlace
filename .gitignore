# Environment files. Only .env.example is committed: everything else may hold
# the memorial's real details, which are deliberately kept out of the
# repository (see README, "Keeping the real details out of the repository").
.env
.env.*
!.env.example

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code local settings
.claude/settings.local.json
