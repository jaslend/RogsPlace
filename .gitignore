# Dependencies
node_modules/

# Build output
dist/

# Wrangler local state (simulated R2, dev cache)
.wrangler/
dist-ssr/
*.local

# Test / coverage output
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files. Only the .example files are committed: everything else may
# hold the memorial's real details or a Worker secret, both of which are
# deliberately kept out of the repository (see README).
.env
.env.*
!.env.example

# Worker secrets for local development.
.dev.vars
.dev.vars.*
!.dev.vars.example

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code local settings
.claude/settings.local.json
