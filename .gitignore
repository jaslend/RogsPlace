# Dependencies
node_modules/

# Build output
dist/

# Wrangler local state (simulated R2, dev cache)
.wrangler/
dist-ssr/
*.local

# Test / coverage output
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
